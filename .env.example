# Google AI Studio key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Motor de ASR: gemini | whisper
POLIGLOTA_ASR=gemini
# Motor de traduccion: gemini | gemma | none
POLIGLOTA_MT=gemini

# Modelos
POLIGLOTA_LIVE_MODEL=gemini-3.8-live
POLIGLOTA_MT_MODEL=gemini-flash-latest

# Solo para POLIGLOTA_ASR=whisper (deploy 100% local, costo cero)
POLIGLOTA_WHISPER_MODEL=small
POLIGLOTA_WHISPER_DEVICE=auto

# Solo para POLIGLOTA_MT=gemma (Ollama local)
OLLAMA_HOST=http://localhost:11434
POLIGLOTA_GEMMA_MODEL=gemma3:4b

HOST=0.0.0.0
PORT=8000
