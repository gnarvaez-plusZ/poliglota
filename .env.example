# Google AI Studio key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Motor de ASR: gemini | whisper
POLIGLOTA_ASR=gemini
# Motor de traduccion: gemini | gemma | none
POLIGLOTA_MT=gemini

# Modelos
POLIGLOTA_LIVE_MODEL=gemini-3.5-transcribe-live
# Medidos como contraproducentes; activar solo para nombres propios raros
POLIGLOTA_ASR_ADAPTATION=0
POLIGLOTA_ASR_DIARIZATION=0
POLIGLOTA_MT_MODEL=gemini-3.5-flash-lite
# Respaldos si el preferido devuelve 503 por saturacion
POLIGLOTA_MT_FALLBACKS=gemini-flash-lite-latest,gemini-flash-latest

# Solo para POLIGLOTA_ASR=whisper (deploy 100% local, costo cero)
POLIGLOTA_WHISPER_MODEL=small
POLIGLOTA_WHISPER_DEVICE=auto

# Solo para POLIGLOTA_MT=gemma (Ollama local)
OLLAMA_HOST=http://localhost:11434
POLIGLOTA_GEMMA_MODEL=gemma3:4b

# Compuerta de voz: no enviar silencio a la API. Apagada por defecto; sobre
# habla continua no ahorra nada. Util en salas abiertas muchas horas.
POLIGLOTA_VAD=0
POLIGLOTA_VAD_THRESHOLD=0.006
# Precio por millon de tokens en USD, para que el panel muestre costo real.
# En cero el panel muestra tokens y no inventa dinero.
POLIGLOTA_COST_PER_MTOK=0

HOST=0.0.0.0
PORT=8000
